#version 300 es
precision highp float;
precision highp int;
precision highp usampler2D;

#define TILE_WIDTH  4u
#define TILE_HEIGHT 4u

#define COLOR_SOURCE_PAYLOAD 0u
#define COLOR_SOURCE_PAINT   1u
#define PAINT_TYPE_SOLID     0u

#define COLOR_SOURCE_SHIFT 30u
#define PAINT_TYPE_SHIFT   27u
#define FILL_RULE_SHIFT    24u
#define COLOR_SOURCE_MASK  0xC0000000u
#define PAINT_TYPE_MASK    0x38000000u
#define FILL_RULE_MASK     0x07000000u

#define FILL_RULE_NONZERO 0u
#define FILL_RULE_EVENODD 1u

// ============================================================================
// Uniforms
// ============================================================================

layout(std140) uniform config {
    uint u_width;
    uint u_height;
    uint u_tile_height;
    uint u_segments_tex_width_bits;
    uint u_segment_list_tex_width_bits;
    uint u_encoded_paints_tex_width_bits;
    uint u_negate_ndc;
    uint _pad0;
};

uniform sampler2D u_segments_texture;
uniform usampler2D u_segment_list_texture;

// ============================================================================
// Varyings from vertex shader
// ============================================================================

flat in ivec4 v_backdrop;
flat in uvec2 v_segment;           // x = offset, y = count
flat in uint  v_payload;
flat in uint  v_paint_flag;
flat in uvec2 v_tile_origin_pixels;
flat in uint  v_depth_index;
in vec2 v_local_xy;

out vec4 fragColor;

// ============================================================================
// Helpers
// ============================================================================

int unpack_i16(int word, int half_idx) {
    int shifted = (word >> (half_idx * 16)) & 0xFFFF;
    if ((shifted & 0x8000) != 0) {
        shifted |= ~0xFFFF;
    }
    return shifted;
}

int get_row_backdrop(int local_y) {
    int word = (local_y < 2) ? v_backdrop.x : v_backdrop.y;
    int half_idx = local_y & 1;
    return unpack_i16(word, half_idx);
}

ivec2 segments_idx_to_coord(uint idx) {
    return ivec2(
        int(idx & ((1u << u_segments_tex_width_bits) - 1u)),
        int(idx >> u_segments_tex_width_bits)
    );
}

ivec2 segment_list_idx_to_coord(uint idx) {
    return ivec2(
        int(idx & ((1u << u_segment_list_tex_width_bits) - 1u)),
        int(idx >> u_segment_list_tex_width_bits)
    );
}

uint get_curve_index(uint list_offset, uint i) {
    uint idx = list_offset + i;
    return texelFetch(u_segment_list_texture, segment_list_idx_to_coord(idx), 0).r;
}

void read_curve(uint curve_idx, out vec2 p0, out vec2 p1, out vec2 p2) {
    uint base_texel = curve_idx * 2u;
    vec4 texel0 = texelFetch(u_segments_texture, segments_idx_to_coord(base_texel), 0);
    vec4 texel1 = texelFetch(u_segments_texture, segments_idx_to_coord(base_texel + 1u), 0);
    p0 = texel0.xy;
    p1 = texel0.zw;
    p2 = texel1.xy;
}

// ============================================================================
// Root-Finding Curve Evaluation (GLLabel / Dobbie approach)
// ============================================================================
//
// For each quadratic bezier, cast a rightward horizontal ray from the pixel.
// Solve bezier_y(t) = pixel.y for t ∈ [0, 1).
// For each valid t, check if bezier_x(t) > pixel.x (crossing is to the right).
// Sign the contribution by the curve's Y-derivative at that t.
//
// This naturally handles non-monotonic curves (0, 1, or 2 crossings per curve).
// No y-monotonization needed. No barycentric / implicit test needed.

// Solve: (p0 - 2*p1 + p2)*t^2 + 2*(p1 - p0)*t + (p0 - target) = 0
// Returns number of roots in [0, 1). Roots stored in `t`.
int solve_bezier_y(float p0, float p1, float p2, float target, out vec2 t) {
    float c = p0 - target;
    float b = 2.0 * (p1 - p0);
    float a = p0 - 2.0 * p1 + p2;

    // Nearly-linear case
    if (abs(a) < 1e-6) {
        if (abs(b) < 1e-6) {
            return 0;
        }
        float root = -c / b;
        if (root >= 0.0 && root < 1.0) {
            t[0] = root;
            return 1;
        }
        return 0;
    }

    // Quadratic formula
    float disc = b * b - 4.0 * a * c;
    if (disc < 0.0) {
        return 0;
    }

    float sqrt_disc = sqrt(disc);
    float inv_2a = 0.5 / a;

    float r0 = (-b + sqrt_disc) * inv_2a;
    float r1 = (-b - sqrt_disc) * inv_2a;

    int count = 0;

    // Half-open [0, 1): at t=0 the crossing belongs to the previous segment's
    // t=1 (which is excluded there). At t=1 the crossing belongs to the next
    // segment's t=0. This guarantees exactly one count per endpoint join.
    if (r0 >= 0.0 && r0 < 1.0) {
        t[count] = r0;
        count++;
    }
    if (r1 >= 0.0 && r1 < 1.0) {
        t[count] = r1;
        count++;
    }

    return count;
}

// Evaluate quadratic bezier at parameter t
float eval_bezier(float p0, float p1, float p2, float t) {
    float mt = 1.0 - t;
    return mt * mt * p0 + 2.0 * t * mt * p1 + t * t * p2;
}
float EPSILON = 0.00001;
vec3 normal = vec3(0.0, 0.0, 1.0);
vec2 d = vec2(0.0, 0.0);
vec2 e = vec2(0.5, 0.0);
vec2 f = vec2(1.0, 1.0);

float cross2d(vec2 a, vec2 b)
{
    return a.x * b.y - a.y * b.x;
}

vec3 barycentric(in vec2 v0, in vec2 v1, in vec2 v2, in vec2 p)
{
	float area = cross2d(v1 - v0, v2 - v0);

	if(abs(area) < EPSILON) {
		return vec3(0.0, 0.0, 0.0);
	}

	vec2 pv0 = v0 - p;
	vec2 pv1 = v1 - p;
	vec2 pv2 = v2 - p;
	
	vec3 asub = vec3(
		cross2d(pv1, pv2),
		cross2d(pv2, pv0),
		cross2d(pv0, pv1)
	);

	return abs(asub) / abs(area);
}
float quad_implicit_contribution(vec2 p0, vec2 p1, vec2 p2, vec2 sample_pos) {
    float sign_v;
    if (p0.y < p2.y) {
        sign_v = -1.0;
    } else if (p0.y > p2.y) {
        sign_v = 1.0;
    } else {
        return 0.0;
    }
    vec3 bary = barycentric(p0, p1, p2, sample_pos);
    float baryLength = bary.x + bary.y + bary.z;
    if (baryLength < EPSILON || baryLength - EPSILON > 1.0) {
        return 0.0;
    }
    vec2 uv = (d * bary.x) + (e * bary.y) + (f * bary.z);
    
    //antialiasing using derivatives
    vec2 px = dFdx(uv);   
    vec2 py = dFdy(uv);   

    //chain rule    
    float fx = (2.0*uv.x)*px.x - px.y;   
    float fy = (2.0*uv.x)*py.x - py.y;   

    //signed distance  
    float sd = (uv.x*uv.x - uv.y) / sqrt(fx*fx + fy*fy); 
    float alpha = 0.5 - sd;
    
    if (alpha < 0.0) {
        return sign_v;
    }
    return 0.0;

}
// ============================================================================
// Paint
// ============================================================================

vec4 unpack_rgba8(uint packed) {
    float r = float((packed >>  0u) & 0xFFu) / 255.0;
    float g = float((packed >>  8u) & 0xFFu) / 255.0;
    float b = float((packed >> 16u) & 0xFFu) / 255.0;
    float a = float((packed >> 24u) & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}


void main() {
    uint fill_rule = (v_paint_flag & FILL_RULE_MASK) >> FILL_RULE_SHIFT;
    uint seg_offset = v_segment.x;
    uint seg_count  = v_segment.y;

    int backdrop_index = int(clamp(uint(floor(v_local_xy.y)) - v_tile_origin_pixels.y, 0u, 3u));
    int raw_winding = 0;
    if (backdrop_index == 0) raw_winding = v_backdrop.x;
    else if (backdrop_index == 1) raw_winding = v_backdrop.y;
    else if (backdrop_index == 2) raw_winding = v_backdrop.z;
    else raw_winding = v_backdrop.w;

    float winding = 0.0;
    if (raw_winding >= 128) winding = 1.0;
    else if (raw_winding <= -128) winding = -1.0;

    vec2 pixel = v_local_xy + vec2(0.5);

    for (uint s = 0u; s < seg_count; s++) {
        uint curve_idx = get_curve_index(seg_offset, s);
        vec2 p0, p1, p2;
        read_curve(curve_idx, p0, p1, p2);
        winding += quad_implicit_contribution(p0, p1, p2, pixel);
    }

    float coverage = clamp(abs(winding), 0.0, 1.0);

    // ── Tile edge visualization ──
    vec2 local_pos = v_local_xy - vec2(v_tile_origin_pixels);
    float edge_x = min(local_pos.x, 4.0 - local_pos.x);
    float edge_y = min(local_pos.y, 4.0 - local_pos.y);
    float edge_dist = min(edge_x, edge_y);

    bool is_edge_pixel = edge_dist < 0.6;
    bool has_segments = seg_count > 0u;
    bool has_backdrop = (abs(raw_winding) > 0);

    // ── Normal fill ──
    if (coverage < 0.004) {
        discard;
    }

    vec4 paint = unpack_rgba8(v_payload);
    fragColor = vec4(paint.rgb, paint.a * coverage);
}

