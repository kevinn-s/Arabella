#version 300 es
precision highp float;
precision highp int;
precision highp usampler2D;

#define TILE_WIDTH                       16u
#define TILE_HEIGHT                      8u

#define COLOR_SOURCE_PAYLOAD             0u
#define COLOR_SOURCE_PAINT               1u
#define PAINT_TYPE_SOLID                 0u

#define COLOR_SOURCE_SHIFT               30u
#define PAINT_TYPE_SHIFT                 27u
#define FILL_RULE_SHIFT                  24u
#define COLOR_SOURCE_MASK                0xC0000000u
#define PAINT_TYPE_MASK                  0x38000000u
#define FILL_RULE_MASK                   0x07000000u

#define FILL_RULE_NONZERO                0u
#define FILL_RULE_EVENODD                1u

layout(std140) uniform config {
    uint u_width;
    uint u_height;
    uint u_tile_height;
    uint u_segments_tex_width_bits;
    uint u_segment_list_tex_width_bits;
    uint u_encoded_paints_tex_width_bits;
    uint u_negate_ndc;
    uint _pad0;
};

uniform sampler2D u_segments_texture;
uniform usampler2D u_segment_list_texture;

flat in ivec4 v_backdrop_lo; // Split attribute components
flat in ivec4 v_backdrop_hi; // Split attribute components
flat in uvec2 v_segment;
flat in uint  v_payload;
flat in uint  v_paint_flag;
flat in uvec2 v_tile_origin_pixels;
flat in uint  v_depth_index;
in vec2       v_local_xy;

out vec4 fragColor;

ivec2 segments_idx_to_coord(uint idx) {
    return ivec2(
        int(idx & ((1u << u_segments_tex_width_bits) - 1u)),
        int(idx >> u_segments_tex_width_bits)
    );
}

ivec2 segment_list_idx_to_coord(uint idx) {
    return ivec2(
        int(idx & ((1u << u_segment_list_tex_width_bits) - 1u)),
        int(idx >> u_segment_list_tex_width_bits)
    );
}

uint get_line_index(uint list_offset, uint i) {
    uint idx = list_offset + i;
    return texelFetch(u_segment_list_texture, segment_list_idx_to_coord(idx), 0).r;
}

void read_line(uint line_idx, out vec2 p0, out vec2 p1) {
    // One flattened line = one RGBA32F texel: (p0.x, p0.y, p1.x, p1.y)
    vec4 t = texelFetch(u_segments_texture, segments_idx_to_coord(line_idx), 0);
    p0 = t.xy;
    p1 = t.zw;
}

vec4 unpack_rgba8(uint packed) {
    float r = float((packed >>  0u) & 0xFFu) / 255.0;
    float g = float((packed >>  8u) & 0xFFu) / 255.0;
    float b = float((packed >> 16u) & 0xFFu) / 255.0;
    float a = float((packed >> 24u) & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}

float line_contribution(vec2 p0, vec2 p1, vec2 pixel) {
    if (p0.y == p1.y) return 0.0;

    float py0 = pixel.y - 0.5;
    float py1 = pixel.y + 0.5;

    float y0 = clamp(p0.y, py0, py1);
    float y1 = clamp(p1.y, py0, py1);
    if (y0 == y1) return 0.0;

    float t0 = (y0 - p0.y) / (p1.y - p0.y);
    float t1 = (y1 - p0.y) / (p1.y - p0.y);
    float x0 = mix(p0.x, p1.x, t0);
    float x1 = mix(p0.x, p1.x, t1);

    float dy = y1 - y0;
    float px1 = pixel.x + 0.5;

    // Distance from RIGHT edge of pixel — 1 if segment is fully left, 0 if fully right
    float w0 = clamp(px1 - x0, 0.0, 1.0);
    float w1 = clamp(px1 - x1, 0.0, 1.0);

    return -0.5 * (w0 + w1) * dy;
}
void main() {
    uint fill_rule = (v_paint_flag & FILL_RULE_MASK) >> FILL_RULE_SHIFT;
    uint seg_offset = v_segment.x;
    uint seg_count  = v_segment.y;

    // Get per-scanline backdrop for this pixel row (Updated to max 7u for 8 vertical rows)
    int backdrop_index = int(clamp(uint(floor(v_local_xy.y)) - v_tile_origin_pixels.y, 0u, 7u));
    
    int raw_winding = 0;
    if (backdrop_index < 4) {
        // Access the low vector (indices 0, 1, 2, 3)
        if (backdrop_index == 0)      raw_winding = v_backdrop_lo.x;
        else if (backdrop_index == 1) raw_winding = v_backdrop_lo.y;
        else if (backdrop_index == 2) raw_winding = v_backdrop_lo.z;
        else                          raw_winding = v_backdrop_lo.w;
    } else {
        // Access the high vector (indices 4, 5, 6, 7)
        int hi_index = backdrop_index - 4;
        if (hi_index == 0)      raw_winding = v_backdrop_hi.x;
        else if (hi_index == 1) raw_winding = v_backdrop_hi.y;
        else if (hi_index == 2) raw_winding = v_backdrop_hi.z;
        else                    raw_winding = v_backdrop_hi.w;
    }

    // Replace the entire main() output with this debug view
vec2 pixel = floor(v_local_xy) + vec2(0.5);

float winding_backdrop = float(raw_winding) / 256.0;

float winding_segments = 0.0;
for (uint s = 0u; s < seg_count; s++) {
    uint line_idx = get_line_index(seg_offset, s);
    vec2 p0, p1;
    read_line(line_idx, p0, p1);
    winding_segments += line_contribution(p0, p1, pixel);
}

float winding_total = winding_backdrop + winding_segments;


  if (float(v_tile_origin_pixels.x) >= 272.0 && float(v_tile_origin_pixels.x) < 288.0 && pixel.y >= 128.0 && pixel.y < 136.0) {
      
float coverage;
    if (fill_rule == FILL_RULE_NONZERO) {
        coverage = (abs(winding_backdrop))  > 0.1 ? 1.0 : 0.0;
    } else {
        // Even-odd
        coverage = (mod(abs(winding_segments), 2.0) > 0.5) ? 1.0 : 0.0;
    }

    if (coverage < 0.004) {
        discard;
    }

    // Resolve paint
    vec4 paint = unpack_rgba8(v_payload);
    fragColor = vec4(paint.rgb * paint.a * coverage, paint.a * coverage);
        }

return;
}